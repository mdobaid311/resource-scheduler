      "css": {
        "@utility ocrs-shadow-xs": {
          "box-shadow": "var(--rs-shadow-xs)"
        },
        "@utility ocrs-shadow-sm": {
          "box-shadow": "var(--rs-shadow-sm)"
        },
        "@utility ocrs-shadow": {
          "box-shadow": "var(--rs-shadow)"
        },
        "@utility ocrs-shadow-md": {
          "box-shadow": "var(--rs-shadow-md)"
        },
        "@layer base": {
          ".rs-root, .rs-root *, .rs-root *::before, .rs-root *::after": {
            "box-sizing": "border-box",
            "border-color": "var(--rs-border)"
          },
          ".rs-root button": {
            "background-color": "transparent",
            "color": "inherit",
            "font": "inherit"
          },
          ".rs-root svg": {
            "display": "block"
          }
        }
      },
      "docs": "Added to components/resource-scheduler. Use it with: import { ResourceScheduler } from \"@/components/resource-scheduler\". Its design tokens (--rs-*) and utilities were added to your CSS and are scoped to .rs-root, so your existing theme is untouched. Needs Tailwind v4 (and tw-animate-css for the popover animations, which shadcn installs by default). Docs: https://github.com/mdobaid311/resource-scheduler#readme"
    }
