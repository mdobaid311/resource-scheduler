---
// The showcase: every recipe in one dashboard. A standalone page (not Starlight) so its
// own chrome and theme switch do not fight the docs layout.
import "../styles/scheduler.css";
import "../showcase/styles.css";
import App from "../showcase/App";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>React Resource Timeline Demos | Resource Scheduler</title>
    <meta
      name="description"
      content="Live React resource timeline demos: room booking, shift rosters, equipment rental, field service and project allocation. Drag, resize, switch theme and density."
    />
    <link rel="canonical" href={new URL(base.slice(1) + "showcase/", Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Resource Scheduler" />
    <meta property="og:title" content="Resource Scheduler Showcase" />
    <meta
      property="og:description"
      content="Six working recipes on one page: drag, resize, book, assign. Switch theme and density live."
    />
    <meta property="og:image" content={new URL("og.png", Astro.site + base.slice(1)).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Resource Scheduler Showcase" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      try {
        var s = JSON.parse(localStorage.getItem("rs-showcase") || "{}");
        if (s.theme === "light" || s.theme === "dark" || s.theme === "system")
          document.documentElement.dataset.theme = s.theme;
      } catch (e) {}
    </script>
  </head>
  <body>
    <App client:only="react">
      <div slot="fallback" class="app" aria-busy="true">
        <aside class="sidebar"></aside>
        <div class="main"><main><div class="page-head"><h1>Resource Scheduler</h1><p>Loading the live recipes…</p></div></main></div>
      </div>
    </App>
  </body>
</html>
